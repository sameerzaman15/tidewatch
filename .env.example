# Public site URL used for metadata, sitemap, and social images.
# Required in production. Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When both are set, waitlist entries and rate limits persist in Upstash Redis.
# Without them, storage is an in-memory Map that resets on a cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. When set, each new waitlist or contact entry is also POSTed here
# (Google Sheets via Apps Script, Zapier, Make, or a CRM webhook).
WAITLIST_WEBHOOK_URL=
